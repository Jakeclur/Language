{
  "name": "leer-afrikaans",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Learn Afrikaans from English: course, exercises, spaced repetition and a full dictionary with formal, informal, slang and vulgar terms.",
  "scripts": {
    "dev": "vite",
    "build": "npm run content && tsc -b && vite build",
    "audio:bakeoff": "node pipeline/audio/generate-audio.mjs --bakeoff",
    "preview": "vite preview",
    "content": "node pipeline/build-content.mjs",
    "verify": "node pipeline/build-content.mjs --strict",
    "import": "node pipeline/import/fetch-sources.mjs",
    "audio": "node pipeline/audio/generate-audio.mjs",
    "audio:qa": "node pipeline/audio/qa-audio.mjs",
    "test": "npm run content -- --quiet && vitest run",
    "lint": "tsc -b --noEmit"
  },
  "dependencies": {
    "minisearch": "^7.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ts-fsrs": "^5.4.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  }
}
