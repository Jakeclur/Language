  "pronunciation": [
    { "spelling": "g", "ipa": "x", "example": "goed", "tip": "Throaty, like Scottish \"loch\" or German \"Bach\". Never like English \"go\" (except in a few loanwords)." },
    { "spelling": "r", "ipa": "r", "example": "rooi", "tip": "Rolled or tapped with the tip of the tongue." },
    { "spelling": "w", "ipa": "v / w", "example": "water", "tip": "Like English v, but softer. After a consonant (twee) it's closer to English w." },
    { "spelling": "v", "ipa": "f", "example": "vis", "tip": "Usually like English f." },
    { "spelling": "j", "ipa": "j", "example": "ja", "tip": "Like English y in \"yes\"." },
    { "spelling": "tj", "ipa": "c / tʃ", "example": "baadjie", "tip": "Like the ch in \"church\", or a soft k-y sound." },
    { "spelling": "a / aa", "ipa": "a / ɑː", "example": "man / maan", "tip": "Short a like \"cut\"; long aa like \"father\"." },
    { "spelling": "e", "ipa": "ɛ / æ / ə", "example": "ek / lekker / die", "tip": "Short e is like \"bed\" (often more open, like \"bad\"); unstressed e is a quick \"uh\"." },
    { "spelling": "ee", "ipa": "iə", "example": "een", "tip": "Glides: \"ee-uh\"." },
    { "spelling": "ê", "ipa": "ɛː", "example": "sê", "tip": "Long, open e, like \"air\" without the r." },
    { "spelling": "ë", "ipa": "(new syllable)", "example": "geëet", "tip": "The dots show a new syllable starts: ge-eet." },
    { "spelling": "i", "ipa": "ə", "example": "dit", "tip": "Usually a short \"uh\", NOT like English \"it\"." },
    { "spelling": "ie", "ipa": "i", "example": "sien", "tip": "Like \"see\"." },
    { "spelling": "o / oo", "ipa": "ɔ / uə", "example": "kop / groot", "tip": "Short o like \"pot\"; long oo glides \"oo-uh\"." },
    { "spelling": "ô", "ipa": "ɔː", "example": "môre", "tip": "Long o, like \"saw\"." },
    { "spelling": "oe", "ipa": "u", "example": "boek", "tip": "Like \"book\" or \"food\"." },
    { "spelling": "u / uu", "ipa": "œ / y", "example": "bus / uur", "tip": "Rounded front vowels: say \"ee\" with rounded lips for uu." },
    { "spelling": "ei / y", "ipa": "əi", "example": "klein / vyf", "tip": "Both spellings sound the same, like \"ay\" in \"say\"." },
    { "spelling": "ui", "ipa": "œy", "example": "huis", "tip": "Start with rounded lips, glide to \"ee\". Like \"ay\" with pursed lips." },
    { "spelling": "ou", "ipa": "əu", "example": "koud", "tip": "Like \"oh\" in British English." },
    { "spelling": "eu", "ipa": "øː", "example": "seun", "tip": "Like French \"peu\": say \"ay\" with rounded lips." },
    { "spelling": "'n", "ipa": "ə", "example": "'n hond", "tip": "A quick \"uh\", like the a in \"about\"." },
    { "spelling": "-ig / -ige", "ipa": "əx", "example": "gelukkig", "tip": "The g at the end is the throaty g too." }
  ]
}
