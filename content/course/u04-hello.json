      "id": "u04-1",
      "title": "Greetings",
      "explanation": [
        "**hallo** = hello, any time of day.",
        "More polite: **goeie môre** (good morning), **goeie middag** (good afternoon), **goeie naand** (good evening).",
        "**totsiens** = goodbye.",
        "**dankie** = thank you, **asseblief** = please."
      ],
      "examples": [
        {
          "af": "Hallo!",
          "en": "Hello!"
        },
        {
          "af": "Goeie môre!",
          "en": "Good morning!"
        },
        {
          "af": "Twee, asseblief.",
          "en": "Two, please."
        },
        {
          "af": "Dankie! Totsiens!",
          "en": "Thank you! Goodbye!"
        }
      ],
