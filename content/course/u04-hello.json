    {
      "id": "u04-2",
      "title": "How are you?",
      "explanation": [
        "**Hoe gaan dit?** = How are you? (literally *how goes it?*)",
        "Answer: **Dit gaan goed, dankie.** = I'm fine, thanks.",
        "Ask back: **En met jou?** = And you? (**met** = with, **jou** = you, after a word like *met*)."
      ],
      "examples": [
        {
          "af": "Hoe gaan dit?",
          "en": "How are you?"
        },
        {
          "af": "Dit gaan goed, dankie.",
          "en": "I'm fine, thanks."
        },
        {
          "af": "En met jou?",
          "en": "And you?"
        },
        {
          "af": "Hallo! Hoe gaan dit met jou?",
          "en": "Hello! How are you?"
        }
      ],
