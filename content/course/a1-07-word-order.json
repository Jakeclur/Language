        { "type": "choice", "question": "Which sentence is correct?", "options": ["Vandag ek werk.", "Vandag werk ek.", "Werk vandag ek."], "answer": "Vandag werk ek." },
        { "type": "transform", "instruction": "Start the sentence with \"Môre\"", "from": "Ek gaan môre skool toe.", "answers": ["Môre gaan ek skool toe."] },
