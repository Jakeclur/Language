    {
      "id": "u06-2",
      "title": "Speak, learn, read, write",
      "explanation": [
        "**praat** = speak / talk, **leer** = learn, **lees** = read, **skryf** = write.",
        "To ask a question, put the verb first: **Jy praat Engels.** → **Praat jy Engels?**"
      ],
      "examples": [
        {
          "af": "Ek leer Afrikaans.",
          "en": "I'm learning Afrikaans."
        },
        {
          "af": "Praat jy Engels?",
          "en": "Do you speak English?"
        },
        {
          "af": "Sy lees 'n boek.",
          "en": "She is reading a book."
        },
        {
          "af": "Hy skryf baie.",
          "en": "He writes a lot."
        }
      ],
      "vocab": [
        "praat",
        "leer",
        "lees",
        "skryf",
        "Afrikaans",
        "Engels"
      ],
      "exercises": [
        {
          "type": "translate",
          "from": "en",
          "prompt": "I am learning Afrikaans.",
          "answers": [
            "Ek leer Afrikaans."
          ]
        },
        {
          "type": "translate",
          "from": "en",
          "prompt": "Do you speak English?",
          "answers": [
            "Praat jy Engels?",
            "Praat u Engels?"
          ]
        },
        {
          "type": "order",
          "en": "She is reading a book.",
          "af": "Sy lees 'n boek."
        },
        {
          "type": "transform",
          "instruction": "Turn it into a question",
          "from": "Jy praat Afrikaans.",
          "answers": [
            "Praat jy Afrikaans?"
          ]
        },
        {
          "type": "translate",
          "from": "af",
          "prompt": "Ons leer Engels.",
          "answers": [
            "We are learning English.",
            "We learn English."
          ]
        },
        {
          "type": "fill",
          "af": "Hulle ___ 'n boek. (are writing)",
          "en": "They are writing a book.",
          "answers": [
            "skryf"
          ],
          "options": [
            "skryf",
            "lees",
            "praat"
