    {
      "id": "u06-3",
      "title": "Play, work, live, sleep",
      "explanation": [
        "**speel** = play, **werk** = work, **woon** = live (in a place), **slaap** = sleep.",
        "**in** = in. **sokker** = soccer. **Kaapstad** = Cape Town."
      ],
      "examples": [
        {
          "af": "Hulle speel sokker.",
          "en": "They play soccer."
        },
        {
          "af": "Ek woon in Kaapstad.",
          "en": "I live in Cape Town."
        },
        {
          "af": "Sy werk baie.",
          "en": "She works a lot."
        },
        {
          "af": "Die kat slaap.",
          "en": "The cat is sleeping."
        }
      ],
      "vocab": [
        "speel",
        "werk",
        "woon",
        "slaap",
        "in",
        "sokker"
      ],
