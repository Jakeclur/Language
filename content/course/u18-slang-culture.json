    {
      "id": "u18-2",
      "title": "Little words with big flavour",
      "explanation": [
        "These small words make you sound natural:",
        "**nou-nou** = in a moment (NOT \"right now\"!). **Ek kom nou-nou.**",
        "**sommer** = just, for no particular reason. **mos** = you know, after all: **Ek het mos gesê!** (I told you so!)",
        "**darem** = at least, really. **ja-nee** = yes indeed (literally yes-no!).",
        "**eina** = ouch. **ag** = oh. **warm** = warm, hot."
      ],
      "examples": [
        {
          "af": "Ek kom nou-nou.",
          "en": "I'll be there in a moment."
        },
        {
          "af": "Ek het mos gesê!",
          "en": "I told you so!"
        },
        {
          "af": "Ja-nee, dit is warm vandag.",
          "en": "Yes indeed, it's hot today."
        },
        {
          "af": "Ag nee!",
          "en": "Oh no!"
        }
      ],
      "vocab": [
        "nou-nou",
        "sommer",
        "mos",
        "darem",
        "ja-nee",
        "eina",
        "ag",
        "warm"
      ],
      "exercises": [
