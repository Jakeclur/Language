      "id": "u18-1",
      "title": "Everyday slang",
      "explanation": [
        "These words are everywhere in casual South African speech, and many are used in South African English too.",
        "**kuier** = visit / hang out: relaxed time together, a core part of the culture. **Kom kuier by ons!** (**by** = at / with)",
        "**ou** = guy (**'n goeie ou** = a good guy). **babbelas** = hangover. **dop** = a drink, or to fail a test (**toets**).",
        "**bakkie** = pickup truck. **robot** = traffic light! **lus vir** = in the mood for (**vir** = for)."
      ],
      "examples": [
        {
          "af": "Kom kuier Saterdag by ons!",
          "en": "Come hang out with us on Saturday!"
        },
        {
          "af": "Hy het die toets gedop.",
          "en": "He failed the test."
        },
        {
          "af": "Ek het 'n babbelas.",
          "en": "I've got a hangover."
        },
        {
          "af": "Die robot is rooi.",
          "en": "The traffic light is red."
        }
      ],
      "vocab": [
        "kuier",
        "ou",
        "babbelas",
        "dop",
        "bakkie",
        "robot",
        "lus",
        "by",
        "vir",
        "toets"
      ],
      "exercises": [
        {
          "type": "choice",
          "question": "In South Africa, a **robot** on the road is…",
          "options": [
            "a traffic light",
            "a speed camera",
            "a police officer"
          ],
          "answer": "a traffic light"
        },
        {
          "type": "choice",
          "question": "**Hy het die toets gedop** means…",
          "options": [
            "He failed the test",
