      "id": "u12-1",
      "title": "My family",
      "explanation": [
        "**familie** = family / relatives, **ouers** = parents.",
        "**broer** = brother, **suster** = sister, **ouma** = granny, **oupa** = grandpa. South Africans say *ouma* and *oupa* even in English!",
        "**plaas** = farm, **op** = on, **tuis** = at home."
      ],
      "examples": [
        {
          "af": "Ek het twee broers.",
          "en": "I have two brothers."
        },
        {
          "af": "My ouma woon op 'n plaas.",
          "en": "My granny lives on a farm."
        },
        {
          "af": "My ouers is tuis.",
          "en": "My parents are at home."
        },
        {
          "af": "Haar suster is baie gelukkig.",
          "en": "Her sister is very happy."
        }
      ],
      "vocab": [
        "familie",
        "ouers",
        "broer",
        "suster",
        "ouma",
        "oupa",
        "plaas",
        "op",
        "tuis"
      ],
