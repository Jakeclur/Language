  "lessons": [
    {
      "id": "a1-09-1",
      "title": "Two nie's",
      "explanation": [
        "Afrikaans usually puts **nie** twice in a negative sentence: once after the verb and once **at the very end**.",
        "**Ek praat nie Afrikaans nie.** = I don't speak Afrikaans.",
        "If the sentence is very short and *nie* is already last, you only need one: **Ek weet nie.** (I don't know.)",
        "Don't! = **Moenie … nie!** → **Moenie raas nie!** (Don't make noise!)"
      ],
      "examples": [
        { "af": "Ek praat nie Afrikaans nie.", "en": "I don't speak Afrikaans." },
        { "af": "Ek verstaan nie.", "en": "I don't understand." },
        { "af": "Sy is nie moeg nie.", "en": "She isn't tired." },
        { "af": "Moenie huil nie!", "en": "Don't cry!" }
      ],
      "vocab": ["nie", "nee", "verstaan", "weet"],
      "exercises": [
        { "type": "order", "en": "I don't understand.", "af": "Ek verstaan nie." },
        { "type": "order", "en": "I don't speak Afrikaans.", "af": "Ek praat nie Afrikaans nie." },
        { "type": "transform", "instruction": "Make it negative", "from": "Hy is siek.", "answers": ["Hy is nie siek nie."] },
        { "type": "transform", "instruction": "Make it negative", "from": "Ons speel vandag sokker.", "answers": ["Ons speel nie vandag sokker nie.", "Ons speel vandag nie sokker nie."] },
        { "type": "translate", "from": "en", "prompt": "She isn't tired.", "answers": ["Sy is nie moeg nie."] },
        { "type": "translate", "from": "en", "prompt": "I don't know.", "answers": ["Ek weet nie."] },
        { "type": "choice", "question": "Which is correct?", "options": ["Ek is nie honger.", "Ek is nie honger nie.", "Ek nie is honger nie."], "answer": "Ek is nie honger nie." },
        { "type": "translate", "from": "en", "prompt": "Don't cry!", "answers": ["Moenie huil nie!"] }
      ]
    }
  ]
