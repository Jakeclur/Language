      "id": "u07-1",
      "title": "Today, tomorrow, yesterday",
      "explanation": [
        "**vandag** = today, **gister** = yesterday.",
        "**môre** = tomorrow. You already know it from **goeie môre**: it also means *morning*.",
        "**dag** = day (plural **dae**), **week** = week."
      ],
      "examples": [
        {
          "af": "Ek is vandag moeg.",
          "en": "I am tired today."
        },
        {
          "af": "Ek werk môre.",
          "en": "I'm working tomorrow."
        },
        {
          "af": "Ons speel vandag sokker.",
          "en": "We're playing soccer today."
        },
        {
          "af": "'n Week het sewe dae.",
          "en": "A week has seven days."
        }
      ],
      "vocab": [
        "vandag",
        "môre",
        "gister",
        "dag",
        "week"
      ],
