      "title": "At the shop",
      "explanation": [
        "**winkel** = shop, **geld** = money, **prys** = price.",
        "**duur** = expensive, **goedkoop** = cheap (literally *good-buy*!).",
        "**kaart** = card. **Kan ek met 'n kaart betaal?** = Can I pay by card?",
        "You already know **Hoeveel kos dit?** (How much does it cost?)."
      ],
      "examples": [
        {
          "af": "Hoeveel kos die brood?",
          "en": "How much does the bread cost?"
        },
        {
          "af": "Die koffie is duur.",
          "en": "The coffee is expensive."
        },
        {
          "af": "Kan ek met 'n kaart betaal?",
          "en": "Can I pay by card?"
        },
        {
          "af": "Ek het nie geld nie.",
          "en": "I don't have any money."
        }
      ],
      "vocab": [
        "winkel",
        "geld",
        "prys",
        "duur",
        "goedkoop",
        "kaart"
      ],
