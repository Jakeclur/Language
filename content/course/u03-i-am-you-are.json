    {
      "id": "u03-3",
      "title": "Very, and, but, also",
      "explanation": [
        "**baie** = very.",
        "**en** = and (you know it from the numbers!).",
        "**maar** = but.",
        "**ook** = also / too.",
        "**dors** = thirsty, **bang** = scared."
      ],
      "examples": [
        {
          "af": "Ek is baie moeg.",
          "en": "I am very tired."
        },
        {
          "af": "Hy is honger en dors.",
          "en": "He is hungry and thirsty."
        },
        {
          "af": "Sy is moeg, maar gelukkig.",
          "en": "She is tired, but happy."
        },
        {
          "af": "Ons is ook dors.",
          "en": "We are thirsty too."
        }
